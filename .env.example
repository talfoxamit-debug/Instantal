# --- Supabase (Phase 0) ---------------------------------------------------
# Project settings -> API. New projects issue sb_publishable_* keys;
# a legacy anon key works in the same variable.
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time — set them in the hosting
# env BEFORE building (a cache redeploy after adding them won't pick them up).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional alias: if you have a legacy anon key instead, set it here — the code
# accepts NEXT_PUBLIC_SUPABASE_ANON_KEY as a fallback for the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (sb_secret_... / legacy service_role). Needed from
# Phase 2 for workers. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# --- App base URL (Phase 2) ------------------------------------------------
# Absolute base URL of the deployed app. The send-worker builds unsubscribe +
# tracking links from this (no request origin in a cron context), so it MUST
# be set for sending — a missing value refuses to send rather than ship mail
# with a broken unsubscribe footer. e.g. https://app.getfoxstays.com
# Also anchors the Gmail OAuth redirect URI, so it must match the host you
# register in Google Cloud. NEXT_PUBLIC_SITE_URL is accepted as a fallback.
APP_URL=

# --- Workers (Phase 2) -----------------------------------------------------
# Shared secret pg_cron sends when hitting /api/cron/*. Generate with:
# openssl rand -hex 32
CRON_SECRET=

# --- OAuth refresh-token encryption (Phase 2) ------------------------------
# base64-encoded 32-byte key for AES-256-GCM at-rest encryption of Gmail
# refresh tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates stored tokens (reconnect inboxes).
TOKEN_ENCRYPTION_KEY=

# Optional: dedicated secret for signing OAuth `state`. Falls back to
# CRON_SECRET, then TOKEN_ENCRYPTION_KEY, if unset.
OAUTH_STATE_SECRET=

# --- Gmail API OAuth (Phase 2) ---------------------------------------------
# Internal-use OAuth app on your own Google Workspace (no app review).
# Authorized redirect URI: <APP_URL>/api/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Email verification API (Phase 1) ---------------------------------------
# Pick a pay-per-verify vendor (MillionVerifier, ZeroBounce, NeverBounce, …).
# With BOTH unset, import falls back to a syntax-only mock (no address is
# marked "valid"); set both to enable real verification. See
# lib/verification/index.ts (HttpVerificationProvider) to map the vendor's
# response vocabulary before going live.
EMAIL_VERIFICATION_API_KEY=
EMAIL_VERIFICATION_API_URL=

# --- Claude API (Phase 4, reply classification) ------------------------------
ANTHROPIC_API_KEY=
# Model used to classify replies. Defaults to claude-haiku-4-5 (cheap, supports
# structured outputs). Override to escalate to a stronger model.
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5
# Days to wait before auto-resuming a sequence after an out-of-office reply.
OOO_RESUME_DELAY_DAYS=3

# --- Deliverability ops (Phase 5) --------------------------------------------
# Slack-compatible incoming webhook for auto-pause / DNS-regression / blacklist
# alerts. Internal ops alerts only (never cold outreach). Unset = alerts log to
# the worker output instead of posting.
SLACK_ALERT_WEBHOOK_URL=
